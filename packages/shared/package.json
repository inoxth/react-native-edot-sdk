{
  "name": "@inoxth/react-native-edot-shared",
  "version": "0.2.2",
  "description": "EDOT shared core — cross-cutting state used by navigation and instrumentation packages",
  "license": "MIT",
  "author": {
    "name": "INOX",
    "url": "https://github.com/inoxth"
  },
  "homepage": "https://github.com/inoxth/react-native-edot-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inoxth/react-native-edot-sdk.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/inoxth/react-native-edot-sdk/issues"
  },
  "keywords": [
    "opentelemetry",
    "edot",
    "react-native",
    "apm",
    "elastic",
    "observability"
  ],
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!lib/tsconfig.tsbuildinfo"
  ],
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "scripts": {
    "build": "bob build",
    "clean": "rimraf lib tsconfig.tsbuildinfo",
    "lint": "oxlint src/",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "typescript": "~5.8.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  }
}
