{
  "name": "@inox/react-native-edot-tracer-provider",
  "version": "0.1.0",
  "description": "EDOT TracerProvider — OTel-compatible manual instrumentation for React Native",
  "license": "MIT",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "!**/__tests__"
  ],
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "scripts": {
    "build": "bob build",
    "clean": "rimraf lib tsconfig.tsbuildinfo",
    "lint": "oxlint src/",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@inox/react-native-edot-sdk": "workspace:*",
    "@inox/react-native-edot-shared": "workspace:*"
  },
  "devDependencies": {
    "react": "^19.2.3",
    "react-native": "^0.85.1",
    "rimraf": "^6.1.3",
    "typescript": "~5.8.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
