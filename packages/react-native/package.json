{
  "name": "@inoxth/react-native-edot-sdk",
  "version": "0.1.0",
  "description": "EDOT React Native SDK — OpenTelemetry-compliant observability wrapping native EDOT SDKs",
  "license": "MIT",
  "author": {
    "name": "INOX",
    "url": "https://github.com/inoxth"
  },
  "homepage": "https://github.com/inoxth/react-native-edot-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inoxth/react-native-edot-sdk.git",
    "directory": "packages/react-native"
  },
  "bugs": {
    "url": "https://github.com/inoxth/react-native-edot-sdk/issues"
  },
  "keywords": [
    "opentelemetry",
    "edot",
    "react-native",
    "apm",
    "elastic",
    "observability"
  ],
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "ios",
    "android",
    "EdotReactNative.podspec",
    "!**/__tests__",
    "!**/AGENTS.md",
    "!android/build",
    "!lib/tsconfig.tsbuildinfo"
  ],
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "typesVersions": {
    "*": {
      "active-view-context": [
        "src/activeViewContext.ts"
      ],
      "nativeModule": [
        "src/nativeModule.ts"
      ]
    }
  },
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "types": "./lib/typescript/index.d.ts"
    },
    "./active-view-context": {
      "react-native": "./src/activeViewContext.ts",
      "import": "./lib/module/activeViewContext.js",
      "require": "./lib/commonjs/activeViewContext.js",
      "types": "./lib/typescript/activeViewContext.d.ts"
    },
    "./nativeModule": {
      "react-native": "./src/nativeModule.ts",
      "import": "./lib/module/nativeModule.js",
      "require": "./lib/commonjs/nativeModule.js",
      "types": "./lib/typescript/nativeModule.d.ts"
    }
  },
  "scripts": {
    "build": "bob build",
    "clean": "rimraf lib tsconfig.tsbuildinfo",
    "lint": "oxlint src/",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@inoxth/react-native-edot-shared": "workspace:*"
  },
  "devDependencies": {
    "react": "^19.2.3",
    "react-native": "^0.85.1",
    "rimraf": "^6.1.3",
    "typescript": "~5.8.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.75.0"
  },
  "codegenConfig": {
    "name": "EdotReactNativeSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.edot.reactnative"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  }
}
