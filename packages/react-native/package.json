{
  "name": "@inox-edot/react-native",
  "version": "0.1.0",
  "description": "EDOT React Native SDK — OpenTelemetry-compliant observability wrapping native EDOT SDKs",
  "license": "MIT",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "ios",
    "android",
    "!**/__tests__"
  ],
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "types": "./lib/typescript/index.d.ts"
    },
    "./active-view-context": {
      "react-native": "./src/activeViewContext.ts",
      "import": "./lib/module/activeViewContext.js",
      "require": "./lib/commonjs/activeViewContext.js",
      "types": "./lib/typescript/activeViewContext.d.ts"
    },
    "./nativeModule": {
      "react-native": "./src/nativeModule.ts",
      "import": "./lib/module/nativeModule.js",
      "require": "./lib/commonjs/nativeModule.js",
      "types": "./lib/typescript/nativeModule.d.ts"
    }
  },
  "scripts": {
    "build": "bob build",
    "lint": "oxlint src/",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@inox-edot/core": "workspace:*"
  },
  "devDependencies": {
    "react": "^18.2.0",
    "react-native": "^0.73.6",
    "react-test-renderer": "^18.2.0",
    "typescript": "~5.4.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "typesVersions": {
    "*": {
      "active-view-context": [
        "src/activeViewContext.ts"
      ],
      "nativeModule": [
        "src/nativeModule.ts"
      ]
    }
  },
  "codegenConfig": {
    "name": "EdotReactNativeSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.edot.reactnative"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
