{
  "name": "@inox/react-native-edot-navigation",
  "version": "0.1.0",
  "description": "EDOT React Navigation integration — automatic view span tracking",
  "license": "MIT",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "!**/__tests__"
  ],
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "scripts": {
    "build": "bob build",
    "lint": "oxlint src/",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@inox/react-native-edot-sdk": "workspace:*",
    "@inox/react-native-edot-shared": "workspace:*"
  },
  "devDependencies": {
    "@react-navigation/native": "^6.0.0",
    "react": "^18.2.0",
    "react-native": "^0.73.6",
    "typescript": "~5.4.0"
  },
  "peerDependencies": {
    "@react-navigation/native": ">=6.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
