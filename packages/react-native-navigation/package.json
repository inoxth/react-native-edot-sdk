{
  "name": "@inoxth/react-native-edot-navigation",
  "version": "0.1.2",
  "description": "EDOT navigation integration — unified screen-tracking for react-navigation, expo-router, and Wix react-native-navigation",
  "license": "MIT",
  "author": {
    "name": "INOX",
    "url": "https://github.com/inoxth"
  },
  "homepage": "https://github.com/inoxth/react-native-edot-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inoxth/react-native-edot-sdk.git",
    "directory": "packages/react-native-navigation"
  },
  "bugs": {
    "url": "https://github.com/inoxth/react-native-edot-sdk/issues"
  },
  "keywords": [
    "opentelemetry",
    "edot",
    "react-native",
    "navigation",
    "react-navigation",
    "expo-router",
    "observability"
  ],
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!lib/tsconfig.tsbuildinfo"
  ],
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "scripts": {
    "build": "bob build",
    "clean": "rimraf lib tsconfig.tsbuildinfo",
    "lint": "oxlint src/",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@inoxth/react-native-edot-sdk": "workspace:*",
    "@inoxth/react-native-edot-shared": "workspace:*"
  },
  "devDependencies": {
    "react": "^19.2.3",
    "react-native": "^0.85.1",
    "rimraf": "^6.1.3",
    "typescript": "~5.8.3"
  },
  "peerDependencies": {
    "@react-navigation/native": ">=6.0.0",
    "expo-router": ">=3.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-navigation": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@react-navigation/native": {
      "optional": true
    },
    "expo-router": {
      "optional": true
    },
    "react-native-navigation": {
      "optional": true
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  }
}
