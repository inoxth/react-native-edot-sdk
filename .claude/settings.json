{
  "permissions": {
    "allow": [
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(echo:*)",
      "Bash(pwd:*)",
      "Bash(which:*)",
      "Bash(tree:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git stash:*)",
      "Bash(git merge:*)",
      "Bash(node:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm build:*)",
      "Bash(npx:*)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)",
      "Bash(eslint:*)",
      "Bash(prettier:*)",
      "Bash(tsc:*)",
      "Bash(tsx:*)",
      "Bash(ruff:*)",
      "Bash(black:*)",
      "mcp__pencil"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*credential*)",
      "Read(**/*secret*)",
      "Read(**/*apikey*)",
      "Read(**/*api_key*)",
      "Read(**/*api-key*)",
      "Read(**/*password*)",
      "Read(**/*passwd*)",
      "Read(**/*token*)",
      "Read(**/config/production.*)",
      "Read(**/config/prod.*)",
      "Read(**/config/staging.*)",
      "Read(**.pem)",
      "Read(**.key)",
      "Read(**.p12)",
      "Read(**.pfx)",
      "Read(**.cer)",
      "Read(**.crt)",
      "Read(**id_rsa)",
      "Read(**id_ed25519)",
      "Read(**id_ecdsa)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gh/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/*credential*)",
      "Edit(**/*secret*)",
      "Edit(**/config/production.*)",
      "Edit(**/config/prod.*)",
      "Bash(rm -rf*)",
      "Bash(rm --recursive*)",
      "Bash(rmdir*)",
      "Bash(shred*)",
      "Bash(truncate*)",
      "Bash(sudo*)",
      "Bash(su *)",
      "Bash(doas*)",
      "Bash(pkexec*)",
      "Bash(chmod 777*)",
      "Bash(chmod -R 777*)",
      "Bash(chown*)",
      "Bash(chgrp*)",
      "Bash(setuid*)",
      "Bash(mkfs*)",
      "Bash(dd*)",
      "Bash(fdisk*)",
      "Bash(parted*)",
      "Bash(mount*)",
      "Bash(umount*)",
      "Bash(crontab*)",
      "Bash(curl*|*bash)",
      "Bash(curl*|*sh)",
      "Bash(wget*|*bash)",
      "Bash(wget*|*sh)",
      "Bash(eval*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(prisma migrate reset*)",
      "Bash(prisma db push --force*)",
      "Bash(psql*DROP*)",
      "Bash(mysql*DROP*)",
      "Bash(mongosh*dropDatabase*)",
      "Bash(kubectl delete*)",
      "Bash(kubectl apply*)",
      "Bash(docker rm*)",
      "Bash(docker rmi*)",
      "Bash(docker system prune*)",
      "Bash(terraform destroy*)",
      "Bash(terraform apply*)",
      "Bash(aws iam*)",
      "Bash(aws s3 rb*)",
      "Bash(gcloud projects delete*)",
      "Bash(kill -9*)",
      "Bash(pkill -9*)",
      "Bash(iptables*)",
      "Bash(ufw*)",
      "Bash(nmap*)",
      "Bash(nc -e*)"
    ],
    "defaultMode": "plan",
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/enforce-trash-only.sh"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/enforce-oxfmt.sh"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/block-git-push.sh"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/block-git-C.sh"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/block-git-chain-add-commit.sh"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/enforce-oxlint.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/skill-activation-prompt.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/post-tool-use-tracker.sh"
          }
        ]
      }
    ]
  }
}