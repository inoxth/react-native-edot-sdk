{
  "name": "react-native-edot-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "EDOT React Native SDK — OpenTelemetry-compliant observability for React Native",
  "workspaces": [
    "packages/*",
    "example/*"
  ],
  "scripts": {
    "lint": "oxlint ./packages",
    "fmt": "oxfmt packages/",
    "typecheck": "tsc --build",
    "test": "jest",
    "build": "yarn workspaces foreach -A --include '@inox/*' run build",
    "clean": "yarn workspaces foreach -A --include '@inox/*' run clean"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.85.1",
    "@react-native/jest-preset": "0.85.1",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.12",
    "@types/react": "^19.2.0",
    "jest": "^29.7.0",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "react": "19.2.3",
    "react-native": "0.85.1",
    "react-native-builder-bob": "^0.23.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~5.8.3"
  },
  "packageManager": "yarn@4.1.0",
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
