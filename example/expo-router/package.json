{
  "name": "edot-example-expo-router",
  "version": "0.0.0",
  "private": true,
  "main": "index.js",
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "android:old-arch": "cd android && ./gradlew installDebug -PnewArchEnabled=false && cd ..",
    "ios": "expo run:ios --device 'iPhone 17 Pro'",
    "ios:old-arch": "RCT_NEW_ARCH_ENABLED=0 expo run:ios --device 'iPhone 17 Pro'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inoxth/react-native-edot-navigation": "workspace:*",
    "@inoxth/react-native-edot-sdk": "workspace:*",
    "@inoxth/react-native-edot-tracer-provider": "workspace:*",
    "expo": "~55.0.15",
    "expo-constants": "~55.0.0",
    "expo-linking": "~55.0.0",
    "expo-router": "~55.0.12",
    "expo-status-bar": "~55.0.0",
    "react": "19.2.0",
    "react-native": "0.83.4",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "babel-preset-expo": "~55.0.0",
    "react-native-dotenv": "^3.4.11",
    "typescript": "~5.8.3"
  }
}
