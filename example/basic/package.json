{
  "name": "edot-example",
  "version": "0.0.0",
  "private": true,
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "scripts": {
    "android": "react-native run-android",
    "android:old-arch": "cd android && ./gradlew installDebug -PnewArchEnabled=false && cd ..",
    "ios": "react-native run-ios --simulator 'iPhone 17 Pro'",
    "ios:old-arch": "RCT_NEW_ARCH_ENABLED=0 react-native run-ios --simulator 'iPhone 17 Pro'",
    "start": "react-native start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inox/react-native-edot-sdk": "workspace:*",
    "@inox/react-native-edot-tracer-provider": "workspace:*",
    "react": "19.2.3",
    "react-native": "0.85.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.1",
    "@react-native/metro-config": "0.85.1",
    "@react-native/typescript-config": "0.85.1",
    "react-native-dotenv": "^3.4.11",
    "typescript": "~5.8.3"
  }
}
